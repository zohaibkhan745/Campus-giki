// Prisma Schema for Campus GIKI
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum Role {
  STUDENT
  SOCIETY
  ADVISOR
  DSA_ADMIN
}

enum DsaRole {
  DIRECTOR
  DEPUTY_DIRECTOR
}

enum PlanStatus {
  DRAFT
  PENDING_ADVISOR
  PENDING_ADMIN
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum EventApprovalStatus {
  DRAFT
  PUBLISHED
  PENDING_ADVISOR
  PENDING_ADMIN
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum VenueClearanceStatus {
  PENDING_UPLOAD
  SUBMITTED
  VERIFIED
  REJECTED
}

enum OrganizationType {
  SOCIETY
  CLUB
  TEAM
}

// ==========================================
// Models
// ==========================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  fullName            String
  role                Role      @default(STUDENT)
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  verificationToken   String?   @unique
  verificationExpires DateTime?
  dsaRole             DsaRole?  @default(DEPUTY_DIRECTOR)
  resetPasswordToken  String?   @unique
  resetPasswordExpires DateTime?
  avatarUrl           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // 1-to-1 optional profile relations
  society Society?
  advisor Advisor?
  posts   Post[]

  @@index([role])
  @@index([verificationToken])
  @@index([resetPasswordToken])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societies Society[]
}

model Advisor {
  id          String   @id @default(uuid())
  department  String
  designation String
  userId      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  societies Society[]

  @@index([userId])
}

model Society {
  id               String  @id @default(uuid())
  name             String  @unique
  shortform        String? @default("NA")
  shortDescription String?
  longDescription  String?
  logoUrl          String?
  bannerUrl        String?
  instagram        String?
  facebook         String?
  linkedin         String?
  website          String?
  email            String?
  presidentName    String?
  presidentRegNum  String?
  presidentFaculty String?
  presidentContact String?
  presidentEmail   String?

  executiveCouncil String? @default("[]")

  hasWarning Boolean @default(false)

  isSetupComplete Boolean          @default(false)
  type            OrganizationType @default(SOCIETY)
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String           @unique
  advisorId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisor     Advisor?     @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  events      Event[]
  yearlyPlans YearlyPlan[]

  @@index([advisorId])
  @@index([categoryId])
  @@index([isSetupComplete])
  @@index([type])
}

model Event {
  id               String   @id @default(uuid())
  title            String
  description      String
  eventDate        DateTime
  startTime        String
  endTime          String
  venue            String
  coverImageUrl    String?
  videoUrl         String?
  registrationLink String?

  // Event Form fields
  eventType       String?
  inChargeName    String?
  inChargeRegNum  String?
  inChargeContact String?
  rules           String?

  isPublished         Boolean             @default(true)
  approvalStatus      EventApprovalStatus @default(PUBLISHED)
  editRequestStatus   String? // PENDING, APPROVED, REJECTED
  editRequestReason   String?
  advisorComments     String?
  dsaComments         String?
  advisorApprovedAt   DateTime?
  dsaApprovedAt       DateTime?
  lastChangeRequestBy String?

  // Physical Venue Clearance fields
  venueClearanceStatus     VenueClearanceStatus?
  signedVenueSlipUrl       String?
  venueSlipUploadedAt      DateTime?
  venueClearanceVerifiedAt DateTime?
  venueClearanceNotes      String?

  societyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId])
  @@index([eventDate])
  @@index([isPublished])
  @@index([isPublished, approvalStatus, createdAt(sort: Desc)])
  @@index([isPublished, approvalStatus, eventDate])
}

model YearlyPlan {
  id              String     @id @default(uuid())
  year              Int
  status            PlanStatus @default(DRAFT)
  advisorComments   String?
  editRequestStatus String? // PENDING, APPROVED, REJECTED
  editRequestReason String?
  societyId         String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relationships
  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  plannedEvents PlannedEvent[]

  @@unique([societyId, year])
  @@index([status])
}

model PlannedEvent {
  id           String   @id @default(uuid())
  eventName    String
  startDate    DateTime
  endDate      DateTime
  description  String
  venue        String
  rules        String?
  societyRules String?
  eventType    String?
  duration     String?
  yearlyPlanId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  yearlyPlan YearlyPlan @relation(fields: [yearlyPlanId], references: [id], onDelete: Cascade)

  @@index([yearlyPlanId])
}

model Post {
  id        String   @id @default(uuid())
  title     String   @default("")
  content   String
  imageUrl  String?
  videoUrl  String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
}
