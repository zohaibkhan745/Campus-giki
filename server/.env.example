# Environment Configuration Example
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/campus_giki?schema=public

# JWT Security Configuration
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d

# Database Seeding Configuration
SEED_DEFAULT_PASSWORD=Password@123

# ==========================================
# Email / SMTP Configuration
# ==========================================
# For local dev without email credentials, leave SMTP_* commented out.
# Ethereal Test Account and Terminal Action Links are enabled automatically.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=dsa@giki.edu.pk
# SMTP_PASS=your_app_password
EMAIL_FROM="Campus GIKI DSA" <dsa@giki.edu.pk>
CLIENT_URL=http://localhost:3000

