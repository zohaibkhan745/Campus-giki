# ==========================================
# Campus GIKI - Docker Production Environment Example
# Copy this file to .env before running: docker compose up -d
# ==========================================

# 1. Web Port Exposure
# Port mapped on host machine (80 for standard HTTP, or 8080/3000 if behind reverse proxy)
PORT_HTTP=80

# 2. Database Credentials (PostgreSQL)
POSTGRES_DB=campus_giki
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=SetAStrongDatabasePasswordHere!

# 3. Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_production_encryption_key_change_me!
JWT_EXPIRES_IN=1d

# 4. Domain & URL Configuration
# Public URL accessible by students & faculty (e.g., https://campus.giki.edu.pk or http://localhost)
APP_URL=http://localhost
CLIENT_URL=http://localhost

# 5. Application Settings
NODE_ENV=production
API_PREFIX=api/v1
SWAGGER_ENABLED=false
UPLOAD_MAX_SIZE_MB=25
# Campus Rate Limiting: 3,000 req/min accommodates 5,000+ campus students sharing GIKI Wi-Fi NAT IP
THROTTLE_LIMIT=3000

# 6. Redis In-Memory Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 6. Database Seeding
# Set to true on first deployment to initialize Admin and default categories
AUTO_SEED=false
SEED_DEFAULT_PASSWORD=AdminPassword@123

# 7. Institutional SMTP Email Configuration (Provided by GIKI IT)
SMTP_HOST=mail.giki.edu.pk
SMTP_PORT=587
SMTP_USER=dsa-portal@giki.edu.pk
SMTP_PASS=YourEmailPasswordHere
EMAIL_FROM="Campus GIKI Portal <dsa-portal@giki.edu.pk>"
